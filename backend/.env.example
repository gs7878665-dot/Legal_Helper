# PostgreSQL connection URL (Format: postgresql://<user>:<password>@<host>:<port>/<dbname>)
DATABASE_URL=postgresql://postgres:gaurav@127.0.0.1:5432/legal_helper

# CORS configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Application environment
ENVIRONMENT=development
PROJECT_NAME="Legal Helper API"

# Google Gemini AI Integration (kept backend-only, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# RAG Knowledge System Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=60
RAG_SIMILARITY_THRESHOLD=0.40
RAG_INDEX_VERSION=v1

# Authentication & Token Security Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Document Infrastructure & Private Storage
DOCUMENTS_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_BYTES=10485760


